# --- OBBLIGATORIO -----------------------------------------------------------
# Stringa di connessione PostgreSQL (Supabase, Neon, Railway, Postgres locale…)
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgres://aurea:aurea@localhost:5432/aurea

# --- CONSIGLIATO IN PRODUZIONE ----------------------------------------------
# Segreto per firmare le sessioni (min. 32 caratteri). Se assente viene generato
# automaticamente e salvato nel database.
AUTH_SECRET=

# URL pubblico dell'app (usato nei link delle notifiche)
APP_URL=http://localhost:3000

# Segreto per l'endpoint dei job pianificati: GET /api/cron?secret=...
CRON_SECRET=

# --- OPZIONALE ---------------------------------------------------------------
# Chiavi VAPID per le notifiche push. Se assenti vengono generate
# automaticamente al primo avvio e salvate nel database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

# Abilita SSL verso il database (true per Supabase/Neon)
DATABASE_SSL=false
